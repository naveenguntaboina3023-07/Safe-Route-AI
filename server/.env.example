PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/saferoute?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=https://YOUR_FRONTEND.vercel.app
NODE_ENV=production

# AI Provider — choose one: groq | gemini | openai
AI_PROVIDER=groq
# Get free Groq key at: https://console.groq.com
AI_API_KEY=gsk_your_groq_key_here
